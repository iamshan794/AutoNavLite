<?xml version="1.0"?>
<!-- AI-assisted: written with the help of an AI coding assistant (GitHub Copilot); reviewed by the AutoNav-0 author. -->
<!-- Simplified Perseverance-class rover (approximate dimensions, for visualisation only). -->
<robot name="autonav_rover">
  <material name="body"><color rgba="0.85 0.85 0.85 1"/></material>
  <material name="wheel"><color rgba="0.25 0.25 0.25 1"/></material>
  <link name="base_link"/>
  <link name="chassis">
    <visual><geometry><box size="2.9 2.0 0.6"/></geometry><material name="body"/></visual>
  </link>
  <joint name="chassis_joint" type="fixed"><parent link="base_link"/><child link="chassis"/><origin xyz="0 0 1.0"/></joint>
  <!-- six 52.5 cm wheels -->
  <link name="wheel_lf"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <link name="wheel_lm"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <link name="wheel_lr"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <link name="wheel_rf"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <link name="wheel_rm"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <link name="wheel_rr"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.2625" length="0.25"/></geometry><material name="wheel"/></visual></link>
  <joint name="wheel_lf_joint" type="fixed"><parent link="base_link"/><child link="wheel_lf"/><origin xyz="1.1 1.2 0.2625"/></joint>
  <joint name="wheel_lm_joint" type="fixed"><parent link="base_link"/><child link="wheel_lm"/><origin xyz="0.0 1.25 0.2625"/></joint>
  <joint name="wheel_lr_joint" type="fixed"><parent link="base_link"/><child link="wheel_lr"/><origin xyz="-1.1 1.2 0.2625"/></joint>
  <joint name="wheel_rf_joint" type="fixed"><parent link="base_link"/><child link="wheel_rf"/><origin xyz="1.1 -1.2 0.2625"/></joint>
  <joint name="wheel_rm_joint" type="fixed"><parent link="base_link"/><child link="wheel_rm"/><origin xyz="0.0 -1.25 0.2625"/></joint>
  <joint name="wheel_rr_joint" type="fixed"><parent link="base_link"/><child link="wheel_rr"/><origin xyz="-1.1 -1.2 0.2625"/></joint>
  <!-- Remote sensing mast: pan / tilt driven by /joint_states from the replayed log -->
  <link name="mast"><visual><origin xyz="0 0 0.5"/><geometry><cylinder radius="0.06" length="1.0"/></geometry><material name="body"/></visual></link>
  <joint name="mast_joint" type="fixed"><parent link="chassis"/><child link="mast"/><origin xyz="1.0 -0.55 0.3"/></joint>
  <link name="mast_head_pan"/>
  <joint name="mast_pan" type="revolute"><parent link="mast"/><child link="mast_head_pan"/><origin xyz="0 0 1.0"/><axis xyz="0 0 1"/><limit lower="-3.1416" upper="3.1416" effort="1" velocity="1"/></joint>
  <link name="mast_head"><visual><geometry><box size="0.25 0.5 0.2"/></geometry><material name="body"/></visual></link>
  <joint name="mast_tilt" type="revolute"><parent link="mast_head_pan"/><child link="mast_head"/><axis xyz="0 1 0"/><limit lower="-1.6" upper="1.6" effort="1" velocity="1"/></joint>
</robot>
